# Copy to .env. Demo credentials are public and strictly for local demonstration.
SERVICEPILOT_ENVIRONMENT=demo
SERVICEPILOT_PROVIDER=offline
SERVICEPILOT_DATA_DIR=.servicepilot
SERVICEPILOT_STATUS_URL=http://127.0.0.1:8001
SERVICEPILOT_EMBEDDING_BACKEND=hashing
SERVICEPILOT_MAX_TOOL_CALLS=6
SERVICEPILOT_APPROVAL_TTL_SECONDS=900

# Optional real LLM. This uses external API calls and can incur charges.
# SERVICEPILOT_PROVIDER=openai
# SERVICEPILOT_API_KEY=replace-with-your-key
# SERVICEPILOT_MODEL=gpt-4.1-mini

# Optional semantic retrieval: uv sync --extra semantic
# First use downloads a pretrained model. Not required for offline mode.
# SERVICEPILOT_EMBEDDING_BACKEND=sentence-transformers
# SERVICEPILOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Outside local demo: set production and use explicit random tokens >=32 chars.
# SERVICEPILOT_ENVIRONMENT=production
# SERVICEPILOT_IDENTITIES_JSON='{"replace-with-a-random-token-at-least-32-chars":{"user_id":"alice","services":["atlas","vpn"]}}'
